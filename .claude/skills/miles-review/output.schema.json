{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "handoffs"],
  "properties": {
    "verdict": {"type": "string", "enum": ["ready", "ready after the should-fixes", "blocked"]},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "rule", "title", "location", "line", "evidence", "fix"],
        "properties": {
          "severity": {"type": "string", "enum": ["blocking", "should-fix", "nit"]},
          "rule": {
            "type": "string",
            "enum": [
              "ledger", "lint", "fits-fork", "one-commit", "ledger-shape", "ids", "upstream-edit",
              "extension", "vendored", "patch-page", "evidence", "contract", "comment", "test",
              "pr-body", "attribution", "claim", "secret"
            ]
          },
          "title": {"type": "string"},
          "location": {"type": "string", "description": "A repo path from the diff, or 'PR body' or 'commit <sha8>'."},
          "line": {"type": "integer", "description": "1-based line at the PR head; 0 for a whole file, the PR body or a commit."},
          "evidence": {"type": "string", "description": "The quoted text, or the bundle file and lines it comes from."},
          "fix": {"type": "string", "description": "Exact replacement text or a unified diff."}
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "note"],
        "properties": {
          "owner": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
