+            ),
+        )
+        patcher.start()
+        self.addCleanup(patcher.stop)
+        consumer = patch.object(
+            layout,
+            "consumer_objects",
+            side_effect=lambda layer, _: (
+                layer._cutedsl_wrapper,
+                layer._cutedsl_scales,
+                *layer._cutedsl_scales,
+            ),
+        )
+        consumer.start()
+        self.addCleanup(consumer.stop)
