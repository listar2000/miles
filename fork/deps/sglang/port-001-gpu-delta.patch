+"""HTTP integration for the GPU-delta control plane."""
+
+from collections.abc import Callable
+from http import HTTPStatus
+from typing import Annotated
+
+from fastapi import Body, FastAPI
+from fastapi.responses import ORJSONResponse
+
+from sglang.srt.utils.auth import AuthLevel, auth_level
+from sglang.srt.weight_sync.gpu_delta.io import (
+    ClearGpuDeltaStateReqInput,
+    GetGpuDeltaInfoReqInput,
+    GetGpuDeltaStatusReqInput,
+    UpdateWeightsFromGpuDeltaReqInput,
+)
+
+
+def register_gpu_delta_routes(app: FastAPI, get_global_state: Callable):
+    """Use the app's route class and resolve its tokenizer manager per request."""
+
+    async def dispatch(obj):
+        content = await get_global_state().tokenizer_manager.gpu_delta.request(obj)
+        return ORJSONResponse(
+            content,
+            status_code=HTTPStatus.OK if content["success"] else HTTPStatus.CONFLICT,
+        )
+
+    @app.post("/update_weights_from_gpu_delta")
+    @auth_level(AuthLevel.ADMIN_OPTIONAL)
+    async def update_weights_from_gpu_delta(
+        obj: Annotated[UpdateWeightsFromGpuDeltaReqInput, Body()],
+    ):
+        return await dispatch(obj)
+
+    @app.post("/clear_gpu_delta_state")
+    @auth_level(AuthLevel.ADMIN_OPTIONAL)
+    async def clear_gpu_delta_state(
+        obj: Annotated[ClearGpuDeltaStateReqInput, Body()],
+    ):
+        return await dispatch(obj)
+
+    @app.post("/get_gpu_delta_info")
+    @auth_level(AuthLevel.ADMIN_OPTIONAL)
+    async def get_gpu_delta_info(
+        obj: Annotated[GetGpuDeltaInfoReqInput, Body()],
+    ):
+        return await dispatch(obj)
+
+    @app.post("/get_gpu_delta_status")
+    @auth_level(AuthLevel.ADMIN_OPTIONAL)
+    async def get_gpu_delta_status(
+        obj: Annotated[GetGpuDeltaStatusReqInput, Body()],
+    ):
+        return await dispatch(obj)
diff --git a/python/sglang/srt/weight_sync/gpu_delta/io.py b/python/sglang/srt/weight_sync/gpu_delta/io.py
new file mode 100644
index 0000000000..5d904b23cd
--- /dev/null
+++ b/python/sglang/srt/weight_sync/gpu_delta/io.py
@@ -0,0 +1,78 @@
+"""Feature-owned HTTP and IPC schemas for GPU-delta controls."""
+
+from typing import Any, Dict, List
+
+from sglang.srt.managers.io_struct import BaseReq, hook_custom_types
+
+
+class ClearGpuDeltaStateReqInput(BaseReq, kw_only=True):
+    pass
+
+
+class ReleaseGpuDeltaCacheReqInput(BaseReq, kw_only=True):
+    # Internal second phase, sent only after every rank has closed its resources.
+    owner_rank_ids: List[str]
+
+
+class GetGpuDeltaInfoReqInput(BaseReq, kw_only=True):
+    engine_id: str
+
+
+class PrepareGpuDeltaReqInput(BaseReq, kw_only=True):
+    session_id: str
+    manifest_path: str
+    manifest_sha256: str
+    stream_id: str
+    base_version: int
+    target_version: int
+    plan_digest: str
+    participants: List[Dict[str, Any]]
+    validate_payload_hash: bool = True
+
+
+class UpdateWeightsFromGpuDeltaReqInput(PrepareGpuDeltaReqInput, kw_only=True):
+    release_state: bool = False
+    flush_cache: bool = True
+    abort_all_requests: bool = False
+    weight_version: str | None = None
+
+
+class GetGpuDeltaStatusReqInput(BaseReq, kw_only=True):
+    session_id: str
+
+
+class ApplyGpuDeltaReqInput(BaseReq, kw_only=True):
+    session_id: str
+    flush_cache: bool = True
+    abort_all_requests: bool = False
+
+
+class AbortGpuDeltaReqInput(BaseReq, kw_only=True):
+    session_id: str
+
+
+class ResumeGpuDeltaReqInput(BaseReq, kw_only=True):
+    session_id: str
+    keep_pause: bool = False
+    weight_version: str | None = None
+
+
+class GpuDeltaReqOutput(BaseReq, kw_only=True):
+    success: bool
+    message: str
+    participant: Dict[str, Any]
+
+
+# Register before tokenizer/scheduler/DP-controller receive loops start.
+hook_custom_types(
+    UpdateWeightsFromGpuDeltaReqInput,
+    ClearGpuDeltaStateReqInput,
+    ReleaseGpuDeltaCacheReqInput,
+    GetGpuDeltaInfoReqInput,
+    PrepareGpuDeltaReqInput,
+    GetGpuDeltaStatusReqInput,
+    ApplyGpuDeltaReqInput,
+    AbortGpuDeltaReqInput,
+    ResumeGpuDeltaReqInput,
+    GpuDeltaReqOutput,
+)
diff --git a/python/sglang/srt/weight_sync/gpu_delta/layout.py b/python/sglang/srt/weight_sync/gpu_delta/layout.py
new file mode 100644
index 0000000000..269d35520e
--- /dev/null
+++ b/python/sglang/srt/weight_sync/gpu_delta/layout.py
@@ -0,0 +1,174 @@
+# Copyright 2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+
+"""Immutable canonical layout admission and live-consumer identity checks."""
+
+from __future__ import annotations
+
+from itertools import chain
+
+from sglang.srt.weight_sync.gpu_delta import profiling
+from sglang.srt.weight_sync.gpu_delta.bindings import (
+    BACKEND_LAYOUTS,
+    ConsumerSnapshot,
+    _digest,
+    _tensor_identity,
+)
+from sglang.srt.weight_sync.gpu_delta.derived import nvfp4_derived_update, plan_updates
+from sglang.srt.weight_sync.gpu_delta.flashinfer import consumer_objects
+from sglang.srt.weight_sync.gpu_delta.models import model_mapping
+
+
+class GpuDeltaLayout:
+    """Frozen canonical bindings with generic backend and consumer admission."""
+
+    def __init__(self, model, inventory):
+        from sglang.srt.weight_sync.gpu_delta.host import _natural_key
+
+        if not inventory:
+            raise ValueError("canonical checkpoint metadata is unavailable")
+        # Normalize negotiated wire metadata without changing checkpoint inventory.
+        self.inventory = {name: dict(meta) for name, meta in inventory.items()}
+        mapping = model_mapping(model)
+        self.bindings = []
+        self.excluded = mapping.parameters.excluded
+        for name, meta in self.inventory.items():
+            binding = mapping.bind(name, meta)
+            if binding is not None:
+                self.bindings.append(binding)
+        self.bindings.sort(key=lambda b: _natural_key(b.name))
+        if mapping.parameters.moe_layers:
+            from sglang.srt.runtime_context import get_exec
+
+            _require_fixed_moe_topology(get_exec().moe)
+        self.derived = []
+        self.derived_updates = []
+        self._consumers = []
+        for prefix, layer in mapping.parameters.moe_layers.items():
+            layout = mapping.parameters.moe_layouts[prefix]
+            if layout.format == "nvfp4":
+                self.derived_updates.append(
+                    nvfp4_derived_update(layer, layout.backend, layout.quant_mode)
+                )
+            self._consumers.append(
+                ConsumerSnapshot(
+                    lambda layer=layer, layout=layout: consumer_objects(layer, layout)
+                )
+            )
+        self.derived_updates = plan_updates(
+            self.derived_updates,
+            [
+                target
+                for binding in self.bindings
+                if binding.encoding == "raw_bytes"
+                for target in binding.storage
+            ],
+        )
+        mapping.finish()
+        self.derived.extend(mapping.derived)
+        self._consumers.extend(mapping.consumers)
+        self._parameter_roots = [
+            (module, name, tensor, _tensor_identity(tensor))
+            for module in mapping.parameters.modules.values()
+            for name, tensor in module._parameters.items()
+            if tensor is not None
+        ]
+        self._prepare_identity_checks()
+        self._reject_overlaps(mapping.aliases)
+        self.description = {
+            "layouts": dict(BACKEND_LAYOUTS),
+            "tensors": [b.describe() for b in self.bindings],
+            "excluded": self.excluded,
+        }
+        self.rank_plan_digest = _digest(self.description)
+        self.description["rank_plan_digest"] = self.rank_plan_digest
+
+    def _prepare_identity_checks(self):
+        # Deduplicate geometry once, not in the per-update validation loop.
+        # Separate views sharing storage still require separate geometry checks.
+        checks = chain(
+            (
+                (tensor, expected, "parameter identity")
+                for _, _, tensor, expected in self._parameter_roots
+            ),
+            (
+                (consumer.objects[index], expected, "consumer storage")
+                for consumer in self._consumers
+                for index, expected in consumer.tensors
+            ),
+        )
+        unique = {}
+        for tensor, expected, kind in checks:
+            key = id(tensor)
+            prior = unique.get(key)
+            if prior is None:
+                unique[key] = (tensor, expected, kind)
+            elif prior[1] != expected:
+                raise RuntimeError(
+                    f"GPU delta {kind} changed during admission; readmission required"
+                )
+        self._tensor_checks = tuple(unique.values())
+
+    @profiling.annotate("gpu_delta.check_identity")
+    def check_identity(self):
+        for module, name, tensor, _ in self._parameter_roots:
+            if module._parameters.get(name) is not tensor:
+                raise RuntimeError(
+                    "GPU delta parameter identity changed; readmission required"
+                )
+        for consumer in self._consumers:
+            consumer.check_objects()
+        for tensor, expected, kind in self._tensor_checks:
+            if _tensor_identity(tensor) != expected:
+                raise RuntimeError(f"GPU delta {kind} changed; readmission required")
+
+    def _reject_overlaps(self, model_aliases):
+        # Gate/up intentionally share one interleaved weight/scale allocation;
+        # their maps are disjoint. Other shared storage needs an explicit alias
+        # adapter so a tied parameter is never XORed twice.
+        owners = {}
+        for binding in self.bindings:
+            for tensor in binding.storage:
+                key = tensor.untyped_storage().data_ptr()
+                prior = owners.get(key)
+                if prior and prior != binding.name:
+                    pair = (prior, binding.name)
+                    if not all(".experts." in name for name in pair) and not (
+                        _gate_up_alias(*pair) or model_aliases(*pair)
+                    ):
+                        raise ValueError(f"unclassified live weight alias: {pair}")
+                owners[key] = binding.name
+
+
+def _gate_up_alias(a, b):
+    return (
+        a.replace("gate_proj", "up_proj") == b or b.replace("gate_proj", "up_proj") == a
+    )
+
+
+def _require_fixed_moe_topology(moe):
+    # The canonical expert map is valid only while physical expert ownership is
+    # the trivial EP partition. EPLB/custom/elastic maps can change ownership
+    # without changing tensor pointers, so pointer checks alone cannot admit it.
+    if (
+        moe.enable_eplb
+        or moe.elastic_ep_backend is not None
+        or moe.init_expert_location != "trivial"
+        or moe.ep_num_redundant_experts != 0
+        or (moe.moe_runner_backend, moe.moe_a2a_backend)
+        not in {
+            ("flashinfer_trtllm", "none"),
+            ("flashinfer_trtllm_routed", "none"),
+            ("flashinfer_mxfp4", "none"),
+            ("flashinfer_cutedsl", "none"),
+            ("flashinfer_megamoe", "flashinfer_megamoe"),
+        }
+    ):
+        raise ValueError(
+            "direct GPU deltas require fixed trivial EP, no redundant experts or EPLB, "
+            "and a native FlashInfer runner with its matching dispatcher"
+        )
diff --git a/python/sglang/srt/weight_sync/gpu_delta/memory.py b/python/sglang/srt/weight_sync/gpu_delta/memory.py
new file mode 100644
index 0000000000..49a758f9eb
--- /dev/null
+++ b/python/sglang/srt/weight_sync/gpu_delta/memory.py
@@ -0,0 +1,281 @@
+# Copyright 2026 SGLang Team
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+
+"""Feature-owned allocations admitted for Blackwell hardware decompression.
+
+Each rank owns its persistent host input arena; allocations are never exported
+or imported.
+Device buffers use cuMemAlloc directly, without changing PyTorch's allocator.
+"""
+
+import ctypes
+import logging
+import math
+import weakref
+from functools import cache
+
+logger = logging.getLogger(__name__)
+_device_owners = weakref.WeakValueDictionary()
+
+
+@cache
+def _driver():
+    from cuda.bindings import driver
+
+    _check(driver.cuInit(0), "cuInit")
+    return driver
+
+
+def _check(result, operation):
+    code = result[0]
+    if code:
+        raise RuntimeError(f"GPU-delta allocation {operation} failed: CUDA {code}")
+    return result[1] if len(result) > 1 else None
+
+
+@cache
+def _pointer_attribute_query():
+    # cuda-bindings 13.3.1 exports the new enum but its typed result dispatcher
+    # rejects it before calling CUDA. Keep the image's bindings and query the
+    # same driver API directly in that specific case. CUdeviceptr is uint64;
+    # IS_HW_DECOMPRESS_CAPABLE writes an unsigned-int boolean.
+    library = ctypes.CDLL("libcuda.so.1")
+    query = library.cuPointerGetAttribute
+    query.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint64]
+    query.restype = ctypes.c_int
+    return query
+
+
+def require_de_capable(pointer):
+    driver = _driver()
+    attribute = driver.CUpointer_attribute.CU_POINTER_ATTRIBUTE_IS_HW_DECOMPRESS_CAPABLE
+    try:
+        result = driver.cuPointerGetAttribute(attribute, pointer)
+    except TypeError as error:
+        if (
+            str(error)
+            != "Unsupported attribute: CU_POINTER_ATTRIBUTE_IS_HW_DECOMPRESS_CAPABLE"
+        ):
+            raise
+        capable = ctypes.c_uint(0)
+        status = _pointer_attribute_query()(
+            ctypes.byref(capable), int(attribute), int(pointer)
+        )
+        result = status, capable.value
+    capable = _check(result, "IS_HW_DECOMPRESS_CAPABLE")
+    if not capable:
+        raise RuntimeError("GPU-delta pointer is not hardware-decompression capable")
+
+
+class _DeviceAllocation:
+    """Foreign tensor storage owns this object, including through escaped views.
+
+    Never retain the wrapping tensor here or free while a tensor alias survives.
+    Finalization drains recorded streams even on partial-construction failures;
+    the normal receiver path already joins them before dropping its leases.
+    """
+
+    def __init__(self, size, device, stream):
+        self.address = 0
+        self.release_attempted = False
+        self.device = device
+        self.driver = driver = _driver()
+        self.streams = {stream.cuda_stream: stream}
+        self.context = _check(driver.cuCtxGetCurrent(), "cuCtxGetCurrent")
+        if not int(self.context):
+            raise RuntimeError("GPU-delta device allocation requires a current context")
+        if int(_check(driver.cuCtxGetDevice(), "cuCtxGetDevice")) != device.index:
+            raise RuntimeError("GPU-delta device allocation context/device mismatch")
+        self.size = size
+        self.address = int(_check(driver.cuMemAlloc(size), "cuMemAlloc"))
+        try:
+            require_de_capable(self.address)
+        except BaseException:
+            self._release()
+            raise
+        _device_owners[self.address] = self
+
+    @property
+    def __cuda_array_interface__(self):
+        # Newly allocated bytes have no producer work. PyTorch's CAI importer
+        # retains this owner in the storage deleter; stream safety is explicit.
+        return {
+            "shape": (self.size,),
+            "typestr": "|u1",
+            "data": (self.address, False),
+            "version": 3,
+        }
+
+    def _release(self):
+        if not self.address or self.release_attempted:
+            return
+        # Cleanup failure is retained as a leak rather than an uncertain retry.
+        self.release_attempted = True
+        driver = self.driver
+        _check(driver.cuCtxPushCurrent(self.context), "cuCtxPushCurrent")
+        try:
+            for stream in self.streams.values():
+                stream.synchronize()
+            _check(driver.cuMemFree(self.address), "cuMemFree")
+            self.address = 0
+        finally:
+            _check(driver.cuCtxPopCurrent(), "cuCtxPopCurrent")
+
+    def __del__(self):
+        try:
+            self._release()
+        except Exception:
+            # A failed fence/free must never trigger replay of a committed XOR.
+            # Do not force-free a buffer whose stream completion is uncertain.
+            logger.exception("GPU-delta device allocation cleanup failed")
+
+
+def device_empty(shape, dtype, device):
+    """Allocate only a DE-facing tensor outside the global Torch allocator."""
+    import torch
+
+    device = torch.device(device)
+    shape = (shape,) if isinstance(shape, int) else tuple(shape)
+    if device.type != "cuda" or device.index is None:
+        raise ValueError("GPU-delta device allocation requires an explicit CUDA device")
+    if any(not isinstance(size, int) or size < 0 for size in shape):
+        raise ValueError("GPU-delta device allocation requires nonnegative dimensions")
+    if dtype not in (torch.uint8, torch.int32, torch.int64):
+        raise ValueError("Unsupported GPU-delta device allocation dtype")
+    size = math.prod(shape) * dtype.itemsize
+    if not size:
+        # cuMemAlloc(0) is invalid. Empty tensors have no DE-addressable storage.
+        return torch.empty(shape, dtype=dtype, device=device)
+    with torch.cuda.device(device):
+        # Establish the existing PyTorch primary context; create no new context.
+        stream = torch.cuda.current_stream(device)
+        owner = _DeviceAllocation(size, device, stream)
+        value = torch.as_tensor(owner, dtype=torch.uint8, device=device)
+        if value.data_ptr() != owner.address or value.device != device:
+            raise RuntimeError("GPU-delta CUDA array import must preserve storage")
+        return value.view(dtype).reshape(shape)
+
+
+def record_device_stream(tensor, stream):
+    """Record foreign-storage readers; Tensor.record_stream only covers Torch pools."""
+    owner = _device_owners.get(tensor.untyped_storage().data_ptr())
+    if owner is not None:
+        if stream.device != owner.device:
+            raise ValueError("GPU-delta allocation consumer stream/device mismatch")
+        owner.streams[stream.cuda_stream] = stream
+
+
+class HostAllocation:
+    """One rank's original mapping; close after CPU tasks and GPU readers drain."""
+
+    def __init__(self, capacity, device):
+        self.driver = driver = _driver()
+        self.handle = self.address = 0
+        self.capacity = capacity
+        self.mapped = False
+        self.view = None
+        try:
+            supported = _check(
+                driver.cuDeviceGetAttribute(
+                    driver.CUdevice_attribute.CU_DEVICE_ATTRIBUTE_HOST_NUMA_VIRTUAL_MEMORY_MANAGEMENT_SUPPORTED,
+                    device,
+                ),
+                "HOST_NUMA_VMM_SUPPORTED",
+            )
+            if not supported:
+                raise RuntimeError("GPU-delta requires CUDA HOST_NUMA VMM support")
+            numa = _check(
+                driver.cuDeviceGetAttribute(
+                    driver.CUdevice_attribute.CU_DEVICE_ATTRIBUTE_HOST_NUMA_ID, device
+                ),
+                "HOST_NUMA_ID",
+            )
+            properties = driver.CUmemAllocationProp()
+            properties.type = driver.CUmemAllocationType.CU_MEM_ALLOCATION_TYPE_PINNED
+            properties.requestedHandleTypes = (
+                driver.CUmemAllocationHandleType.CU_MEM_HANDLE_TYPE_NONE
+            )
+            properties.location.type = (
+                driver.CUmemLocationType.CU_MEM_LOCATION_TYPE_HOST_NUMA
+            )
+            properties.location.id = max(0, numa)
+            properties.allocFlags.usage = driver.CU_MEM_CREATE_USAGE_HW_DECOMPRESS
+            granularity = _check(
+                driver.cuMemGetAllocationGranularity(
+                    properties,
+                    driver.CUmemAllocationGranularity_flags.CU_MEM_ALLOC_GRANULARITY_MINIMUM,
+                ),
+                "cuMemGetAllocationGranularity",
+            )
+            self.capacity = (capacity + granularity - 1) // granularity * granularity
+            self.handle = _check(
+                driver.cuMemCreate(self.capacity, properties, 0), "cuMemCreate"
+            )
+            properties = _check(
+                driver.cuMemGetAllocationPropertiesFromHandle(self.handle),
+                "cuMemGetAllocationPropertiesFromHandle",
+            )
+            # Drivers may omit the requested usage flags from this query. The
+            # mapped-pointer capability check below admits actual HW-DE support.
+            if (
+                properties.location.type
+                != driver.CUmemLocationType.CU_MEM_LOCATION_TYPE_HOST_NUMA
+            ):
+                raise RuntimeError("GPU-delta host allocation is not HOST_NUMA")
+            self.address = _check(
+                driver.cuMemAddressReserve(self.capacity, 0, 0, 0),
+                "cuMemAddressReserve",
+            )
+            _check(
+                driver.cuMemMap(self.address, self.capacity, 0, self.handle, 0),
+                "cuMemMap",
+            )
+            self.mapped = True
+            host_access = driver.CUmemAccessDesc()
+            host_access.location.type = (
+                driver.CUmemLocationType.CU_MEM_LOCATION_TYPE_HOST_NUMA
+            )
+            host_access.location.id = 0  # Ignored for host access.
+            host_access.flags = (
+                driver.CUmemAccess_flags.CU_MEM_ACCESS_FLAGS_PROT_READWRITE
+            )
+            device_access = driver.CUmemAccessDesc()
+            device_access.location.type = (
+                driver.CUmemLocationType.CU_MEM_LOCATION_TYPE_DEVICE
+            )
+            device_access.location.id = device
+            device_access.flags = driver.CUmemAccess_flags.CU_MEM_ACCESS_FLAGS_PROT_READ
+            _check(
+                driver.cuMemSetAccess(
+                    self.address, self.capacity, [host_access, device_access], 2
+                ),
+                "cuMemSetAccess",
+            )
+            require_de_capable(self.address)
+            self.view = memoryview(
+                (ctypes.c_ubyte * self.capacity).from_address(int(self.address))
+            ).cast("B")
+        except BaseException:
+            self.close()
+            raise
+
+    def close(self):
+        if self.view is not None:
+            self.view.release()
+            self.view = None
+        if self.mapped:
+            _check(self.driver.cuMemUnmap(self.address, self.capacity), "cuMemUnmap")
+            self.mapped = False
+        if int(self.address):
+            _check(
+                self.driver.cuMemAddressFree(self.address, self.capacity),
+                "cuMemAddressFree",
+            )
+            self.address = 0
+        if int(self.handle):
+            _check(self.driver.cuMemRelease(self.handle), "cuMemRelease")
+            self.handle = 0
diff --git a/python/sglang/srt/weight_sync/gpu_delta/models.py b/python/sglang/srt/weight_sync/gpu_delta/models.py
