+class DeviceStagedArena:
+    """[fork fix-079] Host arena fallback where the HW-decompress host mapping is refused.
+
+    CPU workers fill an ordinary host buffer; before the pause the receiver copies it into
+    a DE-capable device buffer of the same size, which the decoder reads instead.
+    """
+
+    def __init__(self, capacity, device):
+        import torch
+
+        self.capacity, self.device = capacity, device
+        self.host = torch.empty(capacity, dtype=torch.uint8)
+        self.view = memoryview(self.host.numpy()).cast("B")
+        self._device_tensor = None
+
+    def device_image(self):
+        """The DE-capable device copy, allocated on first use from a thread with the CUDA context."""
+        import torch
+
+        if self._device_tensor is None:
+            device = torch.device("cuda", self.device)
+            torch.cuda.set_device(device)
+            torch.empty(0, device=device)  # make the primary context current in this thread
+            self._device_tensor = device_empty((self.capacity,), torch.uint8, device)
+        return self._device_tensor
+
+    def close(self):
+        if self.view is not None:
+            self.view.release()
+        self.view = self.host = self._device_tensor = None
