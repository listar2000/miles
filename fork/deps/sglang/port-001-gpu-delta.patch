+def decode_fixture(codec):
+    blob, entries, expected = bytearray(), [], {}
+    for i in range(97):
+        value = bytes([i % 251]) * (31 + i * 31)
+        encoded = (
+            value
+            if codec == "lz4"
+            else zstd.ZstdCompressor(write_checksum=True).compress(value)
+        )
+        blob.extend(bytes(-len(blob) % 16))
+        start = len(blob)
+        blob.extend(encoded)
+        name = f"t{i}"
+        expected[name] = value
+        entries.append(
+            {
+                "name": name,
+                "encoding": "xor_bytes",
+                "nbytes": len(value),
+                "changed_bytes": len(value),
+                "frames": [{}],
+                "outer": {
+                    "file": "payload",
+                    "encoded_offset": start,
+                    "encoded_bytes": len(encoded),
+                    "decoded_bytes": len(value),
+                    "frames": []
+                    if codec == "lz4"
+                    else [
+                        {
+                            "encoded_offset": 0,
+                            "encoded_bytes": len(encoded),
+                            "decoded_offset": 0,
+                            "decoded_bytes": len(value),
+                        }
+                    ],
+                },
+            }
+        )
+    for name, value in (
+        ("raw", b"raw-target-value"),
+        ("raw-large", bytes(range(256)) * 256),
+    ):
+        start = len(blob)
+        blob.extend(value)
+        expected[name] = value
+        entries.append(
+            {
+                "name": name,
+                "encoding": "raw_bytes",
+                "nbytes": len(value),
+                "changed_bytes": len(value),
+                "frames": [],
+                "raw": {
+                    "file": "payload",
+                    "encoded_offset": start,
+                    "encoded_bytes": len(value),
+                },
+            }
+        )
+    layout, size = host._tensor_layout(entries)
+    return entries, layout, size, {"payload": memoryview(bytes(blob))}, expected
+
