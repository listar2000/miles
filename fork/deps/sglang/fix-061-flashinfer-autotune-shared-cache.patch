+def _snapshot_autotune_cache(cache_path: Path) -> Path:  # [fork fix-061]
+    """Snapshot the cache so the digest check and the load read the same bytes."""
+    snapshot = cache_path.with_name(f".{cache_path.name}.{uuid.uuid4().hex}.read")
